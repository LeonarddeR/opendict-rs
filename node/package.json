{
  "name": "@opendict-rs/node",
  "version": "0.1.0",
  "description": "Node.js bindings for opendict-rs — read StarDict and MDict dictionaries from JavaScript",
  "main": "index.js",
  "types": "index.d.ts",
  "homepage": "https://github.com/callum-gander/opendict-rs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callum-gander/opendict-rs.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/callum-gander/opendict-rs/issues"
  },
  "author": "Callum Gander <callumgander@protonmail.com>",
  "license": "MIT",
  "keywords": [
    "stardict",
    "mdict",
    "dictionary",
    "rust",
    "napi",
    "napi-rs"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "opendict",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "optionalDependencies": {
    "@opendict-rs/node-darwin-x64": "0.1.0",
    "@opendict-rs/node-darwin-arm64": "0.1.0",
    "@opendict-rs/node-linux-x64-gnu": "0.1.0",
    "@opendict-rs/node-linux-arm64-gnu": "0.1.0",
    "@opendict-rs/node-linux-x64-musl": "0.1.0",
    "@opendict-rs/node-linux-arm64-musl": "0.1.0",
    "@opendict-rs/node-win32-x64-msvc": "0.1.0",
    "@opendict-rs/node-win32-arm64-msvc": "0.1.0"
  }
}